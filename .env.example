# Copy this file to .env and fill in real values before running docker compose up

# DATABASE_URL disabled for now — using YAML file storage (see app/storage.py)
# DATABASE_URL=postgresql+asyncpg://mm_user:mm_password@postgres:5432/mm_careers

# Generate a long random string for this — used to protect admin endpoints
ADMIN_API_KEY=replace-with-a-long-random-secret

MAX_UPLOAD_MB=5
APPLY_RATE_LIMIT_COUNT=3
APPLY_RATE_LIMIT_WINDOW_SECONDS=3600
